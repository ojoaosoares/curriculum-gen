# LLM Provider Configuration
# Works with OpenAI, Google Gemini, Groq, DeepSeek, Ollama, OpenRouter, etc.

# Option 1: OpenAI (or OpenAI-compatible providers)
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
# Optional custom endpoint (e.g. http://localhost:11434/v1 for Ollama, https://api.groq.com/openai/v1, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini (uses Gemini OpenAI endpoint automatically)
# GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API Token (Optional, for higher rate limits on repo/README ingestion)
# GITHUB_TOKEN=your_github_personal_access_token_here
